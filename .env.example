# Your Shelter — production config for docker compose
# On the VPS:  cp .env.example .env  then fill in the real DB password.

# Same PostgreSQL as walk-rank; the "your_shelter" database is created automatically on first start.
DATABASE_URL=postgres://admin:GANTI_PASSWORD_DB@43.157.212.14:5432/your_shelter

# Host port the container is published on
APP_PORT=3030

# 1 = trust the X-Forwarded-For header from nginx (needed for the domain setup)
TRUST_PROXY=1

# Posts allowed per IP per minute (kept in memory only)
POSTS_PER_MINUTE=3
